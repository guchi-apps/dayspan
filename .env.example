# アプリ実行時に参照する環境変数（値は空。ローカル開発の記入例は .env.local.example を参照）

# MariaDB接続。DB_* から scripts/construct-database-url.sh が組み立てる（本番）
DATABASE_URL=

# Supabase Auth（他アプリと共有のSupabaseプロジェクト）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 利用を許可するGoogleアカウント（カンマ区切り）。未設定の場合は全員ログイン不可
ALLOWED_GOOGLE_EMAILS=

# Google/NotionのトークンをDBへ保存する際の暗号化鍵（base64エンコードした32byte）
TOKEN_ENCRYPTION_KEY=

# Google Calendar連携用のDaySpan専用OAuthクライアント（ログイン用とは別クライアント）
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# 予定の「場所」欄のAI提案（Claude Messages API）。未設定の場合はAI提案のみ使えない
CLAUDE_CODE_OAUTH_TOKEN=

# デプロイ時のみ使用（DATABASE_URL の組み立て元。scripts/construct-database-url.sh）
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
DB_NAME=

# サーバー間参照用API（/api/internal/*）の共有シークレット（docs/internal-api.md）。
# 未設定の場合はこのAPIだけが503を返す（他の機能には影響しない）
INTERNAL_API_KEY=

# CI/デプロイ通知
SIGNALY_WEBHOOK_URL=
