generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// DaySpanのDBには、Google Calendarの予定本体とNotionタスク本体を恒久的に保存しない
// （docs/spec.md §19）。ここに置くのは連携設定・表示設定・連携メタデータのみ。

// --- 認証 ---
// セッション管理はSupabase Auth側が行うため、Account/Session/VerificationTokenは持たない。
// SupabaseのユーザーID（auth.users.id）を外部キーとして紐付ける。

model User {
  id             String  @id @default(cuid())
  supabaseUserId String  @unique
  email          String? @unique
  name           String?
  image          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  googleAccounts   GoogleAccount[]
  calendarSettings CalendarSetting[]
  notionConnection NotionConnection?
  uiSetting        UiSetting?
  activityPresets  ActivityPreset[]
  runningActivity  RunningActivity?
  widgetToken      WidgetToken?
  travelPlans      TravelPlan[]
  taskEventLinks   TaskEventLink[]

  pushSubscriptions   PushSubscription[]
  notificationSetting NotificationSetting?
  notificationJobs    NotificationJob[]
}

// --- Google Calendar連携 ---
// ログイン用のGoogle OAuth（Supabase Auth）とは別に、DaySpan専用のOAuthクライアントで
// カレンダー権限のみを追加取得する（docs/spec.md §17）。共有Supabase/GCPプロジェクトの
// 同意画面にセンシティブスコープを足さずに済ませるための分離。
model GoogleAccount {
  id           String @id @default(cuid())
  userId       String
  googleUserId String // Google IDトークンの sub
  email        String

  // アクセストークン・リフレッシュトークンは secret-cipher.ts でAES-256-GCM暗号化して保存する
  accessToken          String?   @db.Text
  accessTokenExpiresAt DateTime?
  refreshToken         String    @db.Text
  scope                String    @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  calendarSettings CalendarSetting[]

  @@unique([userId, googleUserId])
  @@index([userId])
}

// 表示対象カレンダーのON/OFFと表示順（docs/spec.md §7）。
// カレンダー名・色はGoogle側が一次情報源のため保存せず、表示時に取得する。
model CalendarSetting {
  id              String @id @default(cuid())
  userId          String
  googleAccountId String
  calendarId      String // Google Calendar API上のカレンダーID

  visible Boolean @default(true) // カレンダー画面に予定を出すか
  // 書き込んでよいか。表示とは別に持つ。見たいだけのカレンダー（共有された予定表など）へ
  // 書き込ませないため、また画面に出さないカレンダーを保存先には使えるようにするため。
  // 判定は services/calendar/write-context.ts で行い、UIではなくサービス層で塞ぐ。
  writeEnabled    Boolean @default(true)
  sortOrder       Int     @default(0)
  isCreateDefault Boolean @default(false) // 予定新規作成時の既定の保存先

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  googleAccount GoogleAccount @relation(fields: [googleAccountId], references: [id], onDelete: Cascade)

  @@unique([googleAccountId, calendarId])
  @@index([userId])
}

// --- Notion連携 ---
// MVPではユーザーがNotionのInternal Integration Tokenを入力する方式（docs/spec.md §18）。
// 将来のNotion OAuthへ差し替えられるよう、トークンの取得元は accessToken に集約する。
model NotionConnection {
  id     String @id @default(cuid())
  userId String @unique

  accessToken   String  @db.Text // 暗号化して保存
  workspaceName String?

  // Notion API 2025-09-03以降、プロパティとクエリの対象はデータベースではなくデータソース。
  // 実際の読み書きには taskDataSourceId を使い、taskDatabaseId は画面表示・リンク用に持つ。
  taskDataSourceId String?
  taskDatabaseId   String?
  taskTitle        String?

  // アプリ側の項目名 → Notionプロパティ名の対応。プロパティ名はユーザーが自由に付けられるため
  // 固定名を前提にせず、接続時の検証結果をここへ保存する（docs/spec.md §9）。
  propertyMap Json?

  // 記念日・更新日など、完了を持たない日付リマインド用のデータソース。
  reminderDataSourceId String?
  reminderDatabaseId   String?
  reminderTitle        String?
  reminderPropertyMap  Json?

  // よく行く場所。予定の「場所」欄の入力候補として読むだけで、DaySpan側には保存しない。
  placeDataSourceId String?
  placeDatabaseId   String?
  placeTitle        String?
  placePropertyMap  Json?

  // ゴミの収集日。myroomが日次で書き直すDBで、DaySpanからは読むだけ（docs/spec.md §9）。
  garbageDataSourceId String?
  garbageDatabaseId   String?
  garbageTitle        String?
  garbagePropertyMap  Json?

  // 勤務場所と出張（docs/spec.md §34）。1日1件の勤務場所と、期間で1件の出張を同じDBに置く。
  // Googleの予定にもタスクにも入る欄が無い記録だが、DaySpanのDBではなくNotionを一次情報源に
  // するのは、後から見返して集計し、手で直す種類の記録のため（場所DBと同じ考え方）。
  workDataSourceId String?
  workDatabaseId   String?
  workTitle        String?
  workPropertyMap  Json?

  // 買い物リスト（docs/spec.md §36）。shopping-listアプリが読み書きしているDBをそのまま指せる。
  // タスク・日付リマインド・場所・勤務と同じく、一次情報源はNotion側でDaySpanには保存しない。
  shoppingDataSourceId String?
  shoppingDatabaseId   String?
  shoppingTitle        String?
  shoppingPropertyMap  Json?

  // 出張扱いにする勤務場所の名前（string[]）。その場所を選んだ時点で「出張」の既定が立つ。
  // UiSettingではなくここに置くのは、勤務場所の選択肢が勤務記録DBのselectのプロパティ定義
  // そのもので、DBを選び直せば選択肢ごと入れ替わるため。UiSettingへ置くと、DBを差し替えた
  // あとも古い場所名が残り、どの画面からも消せなくなる。
  workTripPlaces Json?

  lastValidatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// --- UI表示設定 ---

enum CalendarViewType {
  MONTH
  DAY_1
  DAY_3
  DAY_7
}

model UiSetting {
  id     String @id @default(cuid())
  userId String @unique

  defaultMobileView  CalendarViewType @default(MONTH)
  defaultDesktopView CalendarViewType @default(DAY_7)
  weekStartsOn       Int              @default(0) // 0=日曜
  timeZone           String           @default("Asia/Tokyo")
  autoRefreshSeconds Int              @default(300) // 一定間隔での自動更新（docs/spec.md §20）

  // 活動記録の初期項目（docs/spec.md §27）を入れたかどうか。
  // 「項目が1件も無いなら入れる」だけで判断すると、利用者が全部消しても開き直すたびに
  // 戻ってきて消せなくなる。入れたことがあるかどうかを別に持つ。
  activityPresetsSeeded Boolean @default(false)

  // 活動記録の保存先カレンダー。全ての項目で共通の1つ（docs/spec.md §27）。
  // 未設定なら予定作成の既定の保存先（CalendarSetting.isCreateDefault）へ入れる。
  // カレンダー名・色はGoogle側が一次情報源のため持たない。
  activityCalendarId String?

  // 移動の既定値（docs/spec.md §29）。活動記録の保存先と同じく、項目ごとではなく
  // 利用者につき1組にする。移動のたびに同じ出発地・交通手段を選び直さずに済ませるため。
  travelDefaultOrigin String?
  travelDefaultMode   TravelMode @default(TRAIN)
  // 行きだけ作られても帰りは手で入れ直すことになるため、往復を既定にする。
  travelRoundTrip     Boolean    @default(true)
  // 移動をGoogle Calendarへ書き出す先。未設定なら予定作成の既定の保存先へ入れる。
  travelCalendarId    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// --- 活動記録 ---
// いましていることを押して記録し、終わった時点でGoogle Calendarの予定にする（docs/spec.md §27）。
// 予定の本体はGoogle側に作られる。ここに置くのは選択肢と「まだ終わっていない1件」だけで、
// 終わった記録をDaySpanへ残すことはしない（docs/spec.md §19）。

model ActivityPreset {
  id     String @id @default(cuid())
  userId String

  name      String
  sortOrder Int    @default(0)

  // 保存先カレンダーはここには持たない。項目によらず1つ（UiSetting.activityCalendarId）。

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 同じ名前の選択肢が2つ並ぶと、押したときにどちらが選ばれたのか区別できない。
  // 初期の選択肢を後から足すときも、この一意制約で二重登録を防いでいる。
  @@unique([userId, name])
}

// 進行中の記録。同時に2つのことを記録しても、どちらが「いましていること」か決まらないため
// ユーザーにつき1件（userId が一意）。停止・切り替えの時点でGoogleへ書き出して削除する。
model RunningActivity {
  id     String @id @default(cuid())
  userId String @unique

  title      String
  calendarId String
  startedAt  DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// --- 移動 ---
// 出発地から目的地までの移動（docs/spec.md §29）。
//
// Google Calendarの予定はタイトル・場所・説明しか持てず、出発地と目的地を別々の欄には
// 入れられない。移動に固有の項目を持たせるため、本体はここに置く。
// Google側へは写しを書き出し、他の端末のカレンダーからも見えるようにする（一次情報源はこちら）。

enum TravelMode {
  TRAIN
  CAR
  BUS
  WALK
  BICYCLE
  PLANE
  OTHER
}

/// 所要時間の出どころ。AIの見積もりは目安でしかないため、手で入れた値と区別して示す。
/// 将来Routes APIなどへ差し替えるときも、既存の記録がどちらで入ったか分かるようにする。
/// 所要時間の出どころ（docs/spec.md §29）。
///
/// TRANSIT は trainroute 経由で引いた経路検索の結果。AI の見積もりと同じく確定した時刻では
/// ないが、実際の路線網・乗換・徒歩を計算した値で、精度が違う。区別できないと、あとから
/// 「この数字はどこから来たのか」を読めなくなる。
enum TravelEstimateSource {
  MANUAL
  AI
  TRANSIT
  YAHOO
}

model TravelPlan {
  id     String @id @default(cuid())
  userId String

  origin      String
  destination String
  mode        TravelMode @default(TRAIN)

  departAt DateTime
  arriveAt DateTime

  note           String?              @db.Text
  estimateSource TravelEstimateSource @default(MANUAL)

  // 元になった予定。往路・復路の2件が同じ予定を指す。予定側から移動の有無を引くために持つ。
  linkedEventId    String?
  linkedCalendarId String?
  returnLeg        Boolean @default(false)

  // Googleへ書き出した予定。書き出しに失敗した場合はnullのまま残す（移動そのものは失われない）。
  googleCalendarId String?
  googleEventId    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, departAt])
  // 書き出した予定はGoogleからも取得される。二重に描かないよう、取得した予定のIDで引いて落とす。
  @@index([userId, googleEventId])
}

// --- iPhoneウィジェット連携 ---
// Scriptableから活動記録を読むための専用トークン（docs/spec.md §28）。
// Scriptableはブラウザのログインセッションを持てず、ウィジェットの更新は利用者の操作なしに
// 走るため、Supabaseのセッションでは認証できない。読み取り専用のトークンを1本だけ発行する。
model WidgetToken {
  id     String @id @default(cuid())
  userId String @unique // ウィジェット用は1ユーザー1本。複数の端末でも同じ台本を使い回す

  // 暗号文はIVが毎回変わるため値では引けない。照合はハッシュ側で行い、
  // 暗号文は設定画面での再表示（台本の作り直し・機種変更）にだけ使う。
  tokenHash String @unique @db.VarChar(64) // SHA-256（hex）
  token     String @db.Text // secret-cipher.ts でAES-256-GCM暗号化

  // 最後に使われた日時。ウィジェットが生きているか、古い端末が読み続けていないかを見るため。
  lastUsedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// --- 予定に紐づくタスク ---
// タスクを「この予定のどの段階でやるか」で置く（docs/spec.md §31）。
//
// Google Calendarの予定にもNotionのタスクにも「相手を指す欄」は無く、足せば利用者のDBの
// 構成を変えることになる。予定とタスクを結ぶ線だけをDaySpanが持つ（移動と同じ考え方）。
// 段階から決まる日時はNotionのタスクの「期限」か「予定日」へ書き込むため、カレンダーの
// 描画・取得は既存の日付の経路をそのまま通る。

/// タスクを予定のどの段階に置くか。実施中は開始時刻、終了までは終了時刻に置く。
enum TaskEventStage {
  BEFORE_START
  DURING
  BEFORE_END
  AFTER_END
}

/// 段階から決まる日時をタスクのどちらの日付へ入れるか（docs/spec.md §31）。
/// 締切そのものが予定で決まる（会議で提出する）場合と、いつ手を付けるかが予定で決まる
/// 場合があり、行き先を選べないとどちらかを手で書き写すことになる。
enum TaskLinkTarget {
  DUE
  PLANNED
}

model TaskEventLink {
  id     String @id @default(cuid())
  userId String

  taskId     String // Notionのページ ID
  calendarId String
  eventId    String // 繰り返し予定は展開した1回分のID

  stage TaskEventStage

  // 決まった日時の行き先。既定を予定日にするのは、行き先を足す前の紐づけがすべて予定日へ
  // 書いていたため。既定値のままで既存の行の意味が変わらない。
  target TaskLinkTarget @default(PLANNED)

  // 最後に行き先へ入れた日時。予定が動いてタスクの日付とずれていないかの判定に使う。
  resolvedAt     DateTime
  // 解決した日時が終日（日付のみ）だったか。日付のみと00:00の時刻ありを区別するために持つ。
  resolvedAllDay Boolean  @default(false)

  // 表示用の予定名の写し。一次情報源はGoogleで、取得できたときは最新の値で上書きする。
  // タスク画面や取得範囲の外では予定本体が手元に無く、何に紐づいているか示せないため持つ。
  eventTitle String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 紐づけは行き先ごとに1件。期限と予定日で別の予定へ紐づけられる一方、同じ行き先の2件目は
  // 入る先が1つしか無いため持てても置けない。
  @@unique([userId, taskId, target])
  // 予定を動かした・消したときに、その予定に紐づくタスクを引くため。
  @@index([userId, eventId])
}

// --- 通知 ---
// 予定の前とタスクの期限に知らせる（docs/spec.md §32）。
//
// iOSのホーム画面Webアプリには、端末側で「この時刻に鳴らす」と予約する手段が無い。
// 時刻が来たことに気付けるのはサーバーだけなので、通知はすべてDaySpanから送る。
// 送る瞬間に外部APIを叩かずに済むよう、通知の文面は先に作って NotificationJob へ置く。

/// 通知の出どころ。押したときに開く画面もここで決まる。
enum NotificationKind {
  EVENT
  TASK
  TASK_DIGEST
  ACTIVITY
  TEST
}

/// 通知の送信先（端末ごと）。
///
/// 許可はブラウザが持つもので、iPhoneとPCでは別々になる。「何分前に知らせるか」のような
/// 内容の設定はアカウントにつき1つ（NotificationSetting）で、こちらは端末の数だけ増える。
model PushSubscription {
  id     String @id @default(cuid())
  userId String

  // ブラウザが発行する送信先。長さに上限が決まっておらずMySQLのインデックス長に収まらないため、
  // 引くのはハッシュ側で行う（ウィジェットのトークンと同じ作り）。
  endpoint     String @db.Text
  endpointHash String @unique @db.VarChar(64) // SHA-256（hex）

  // ペイロードの暗号化に使う端末側の公開鍵と認証シークレット（RFC 8291）。
  // どちらもブラウザがその端末のために発行した値で、DaySpanの資格情報ではない。
  p256dh String @db.VarChar(255)
  auth   String @db.VarChar(255)

  /// 購読したときに開いていたアドレス（`https://dayspan.gucchii.com` など）。
  /// 通知を押したときの行き先は絶対URLで渡す必要があり、送信はリクエストの外（タイマー）から
  /// 走るためヘッダーからは作れない。環境変数を1つ増やすより、購読した端末が使っている
  /// アドレスをそのまま持つほうが、本番とローカルの両方で正しい行き先になる。
  origin String @db.VarChar(255)

  /// 設定画面で端末を見分けるための表示名。User-Agentから作る。
  label String?

  lastSuccessAt DateTime?
  lastFailureAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// 何を知らせるか（アカウントにつき1つ）。
model NotificationSetting {
  id     String @id @default(cuid())
  userId String @unique

  // 予定は開始の何分前に知らせるか。0なら開始時刻ちょうど。
  eventEnabled     Boolean @default(true)
  eventLeadMinutes Int     @default(10)

  // タスクは期限の時刻に知らせる。時刻の無い期限はその日ぶんをまとめて1通にし、
  // 送る時刻をここで決める（UiSetting.timeZone での HH:MM）。1件ずつ送ると、
  // 同じ時刻に同じ見た目の通知が期限の数だけ並ぶため。
  taskEnabled    Boolean @default(true)
  taskDigestTime String  @default("08:00") @db.VarChar(5)

  /// 記録を始めたときに「記録中」を通知として残すか（docs/spec.md §27）。
  activityEnabled Boolean @default(true)

  /// 下書きを作り直した最後の時刻。取得の間隔を空けるために持つ。
  plannedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// 送る前の通知1件。
///
/// 予定・タスクの取得は30分に1回にまとめ、その時点で文面まで作っておく。送る直前に
/// 取りにいく作りだと、通知1件ごとにGoogle・Notionへの往復が増える（docs/spec.md §20）。
model NotificationJob {
  id     String @id @default(cuid())
  userId String

  kind NotificationKind

  /// 同じ通知を二重に作らないための鍵。予定が動けば別の値になるよう、日時まで含める。
  dedupeKey String @db.VarChar(191)

  scheduledAt DateTime
  title       String   @db.VarChar(255)
  body        String   @db.Text

  /// 押したときに開くパス。
  url String @db.VarChar(255)

  /// 一緒に更新するアイコンのバッジの件数。送信時に数え直すとNotionへの往復が増えるため、
  /// 下書きを作った時点の件数を持つ。
  badgeCount Int?

  /// 送った時刻。null なら未送信。
  sentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  // 時刻が来た未送信の下書きを引く。
  @@index([sentAt, scheduledAt])
  @@index([userId, scheduledAt])
}
